; ============================================================
; UIAssets.nsh
;
; UI image assets for RNDLogger_Automation installer
; Generated and embedded at compile-time.
;
; Requires:
;   EmbedBmp.nsh
; ============================================================

!ifndef __UIASSETS_NSH__
!define __UIASSETS_NSH__

; ------------------------------------------------------------
; Success Icon (Green)
; ------------------------------------------------------------
!define UI_SUCCESS_BMP "success_green.bmp"

!define UI_SUCCESS_BMP_HEX \
""

!insertmacro EmbedBmp "${UI_SUCCESS_BMP}" "${UI_SUCCESS_BMP_HEX}"

; ------------------------------------------------------------
; Failure Icon (Red)
; ------------------------------------------------------------
!define UI_FAILURE_BMP "error_red.bmp"

!define UI_FAILURE_BMP_HEX \
""

!insertmacro EmbedBmp "${UI_FAILURE_BMP}" "${UI_FAILURE_BMP_HEX}"

!endif ; __UIASSETS_NSH__
